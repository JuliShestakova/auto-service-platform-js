# Скопируйте в .env и заполните значения.
# Файл .env в git не коммитится.

POSTGRES_DB=find_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Для Docker (сервис db):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@db:5432/find_service
# Для локального запуска backend вне Docker:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/find_service
DATABASE_URL=

# Случайная длинная строка для JWT (не коммитьте реальное значение)
SECRET_KEY=

REDIS_URL=redis://redis:6379/0

# Только для локального сида демо-отзывов (необязательно)
DEMO_REVIEWER_PASSWORD=
